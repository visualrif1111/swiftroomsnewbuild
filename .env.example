# Sanity CMS — copy to .env.local and fill in. NEVER commit real values.
#
# Public (safe to expose to the browser — the NEXT_PUBLIC_ prefix ships these
# to the client bundle by design):
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# Public site base URL used for canonical/OG/sitemap/robots and JSON-LD (no
# trailing slash). Defaults to the Vercel production deployment when unset; set
# to https://www.swiftrooms.ae at domain cutover.
NEXT_PUBLIC_SITE_URL=

# Secret (server-only — must NOT have a NEXT_PUBLIC_ prefix, must NOT be
# committed, and should be set in Vercel Environment Variables).
#
# Used server-side to read PUBLISHED content and, when Draft Mode is active
# (inside the Studio's Presentation / Live Preview tool), to read DRAFTS and
# validate the preview secret. It is never sent to the browser. Create one with
# Viewer permission at https://sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Local/CI only — used by the blog migration script. Do NOT add to Vercel.
SANITY_API_WRITE_TOKEN=

# NOTE: no separate SANITY_PREVIEW_SECRET is required. Preview access is secured
# by Sanity's built-in preview-url-secret (validated with SANITY_API_READ_TOKEN
# via next-sanity's draft-mode route), so no extra secret needs managing.
